{% include 'header.twig' %}
	<style>
/* Wrapper content  body */
.wrapper-sidebar-navbar .wrapper-content__body{
 margin-top:100px;
}
/* Import Google Fonts */
{{ settings.user_font_import|raw }}

/* Col */
.orders-history__margin-tab div .col{
 font-family: '{{ settings.user_font }}', {{ settings.user_font_type }} ;
}

@media (max-width:991px){

 /* Wrapper sidebar navbar */
 .wrapper-sidebar-navbar{
  transform:translatex(0px) translatey(0px);
 }
 
 /* Wrapper content  body */
 .wrapper-sidebar-navbar .wrapper-content__body{
  margin-top:15px !important;
 }
 
}



	</style>
    <div class="wrapper-content__body">
      <!-- Main variables *content* -->
      <div id="block_99">
    <div class="orders-history ">
       
       
        <div class="container-fluid">
            <div class="row">
                <div class="col">
                    <div class="orders-history__margin-tab">
                        <div class="component_status_tabs">
                            <div class="">
      <ul class="nav nav-pills tab ">
	  
        <li class="nav-item" >
		
      </ul>
	
     <div class="row">
                <div class="col">
                    <div class="orders-history__margin-table">
                        <div class="table-bg component_table ">
                            <div class="table-wr table-responsive">
        <table class="table ">
          <thead>
            <tr>
            
<th class="width-service-name"><span>        Service ID          </span>    </th>
<th>Service Name</th>
              <th>Description</th>
<th>Date </th> 
              <th>Action</th>
             
            </tr>
          </thead>
          <tbody>
{#reject - #702283#}
{#completed-0e7f00#}
{#inprogress-0721ed#}
{#pending-42b7af#}
{#error-f71111#}


            {% for order in orders %}
              <tr>

<td>{{ order['service_id'] }}</td> 
                <td>{{ order['service_name'] }}</td>
               
                 <td>{{ order['description'] }}</td> 
      <td>{{ order['date'] }}</td> 
          <td>{{ order['action'] }}</td>
               

              </tr>
            {% endfor %}

          </tbody>
        </table>
      </div>
    <br>
       {% if pagination["count"] > 1 %}
        <ul class="pagination">

          {% if pagination["current"] != 1 %}
            <li>
              <a class="btn btn-actions" href="orders/{{ status }}/{{ pagination["previous"] }}{% if search %}?search={{ search }}{% endif %}" aria-label="Previous">
<span aria-hidden="true">«</span>
              </a>
            </li>
          {% endif %}

          {% set r, l = 3, 3 %}

          {% if pagination['current'] == 1 %}
            {% set r = 7 %}
          {% endif %}

          {% if pagination['current'] == 2 %}
            {% set r = 5 %}
          {% endif %}

          {% if pagination['current'] >= pagination['count'] %}
            {% set l = 5 %}
          {% endif %}

          {% for page in 1..pagination["count"] %}
            {% if page >= (pagination['current']-l) and page <= (pagination['current']+r) %}
              <li{% if page == pagination['current'] %} class="active" {%endif%}><a class="btn btn-actions" 
 href="orders/{{ status }}/{{ page }}{% if search %}?search={{ search }}{% endif %}">{{ page }}</a></li>
            {%endif%}
          {% endfor %}

          {% if pagination['current'] < pagination['count'] %}
            <li>
              <a class="btn btn-actions" href="orders/{{ status }}/{{ pagination['next'] }}{% if search %}?search={{ search }}{% endif %}" aria-label="Next">
<span aria-hidden="true">»</span>
              </a>
            </li>
          {% endif %}

        </ul>
      {% endif %}
<br>
   <br>
    </div>
  </div>
</div></div></div></div>
</div></div></div></div></div></div>
</div>




<br><br>
{% include 'new-footer.twig' %}
{% include 'header.twig' %}

<!-- ==================== TICKET PAGE (KrazySMM Green Style) ==================== -->
<div class="dash-head-section" style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;flex-wrap:wrap;gap:16px;">
  <div style="display:flex;align-items:center;gap:14px;">
    <div style="width:44px;height:44px;border-radius:12px;background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.25);display:flex;align-items:center;justify-content:center;color:#10b981;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:22px;height:22px;">
        <path d="M3 9V7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2a3 3 0 0 0 0 6v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2a3 3 0 0 0 0-6Z"/><path d="M13 5v2M13 11v2M13 17v2"/>
      </svg>
    </div>
    <div>
      <h1 style="font-size:22px;font-weight:800;color:#fff;margin:0 0 3px;">Ticket</h1>
      <p style="font-size:13.5px;color:#7b8ca6;margin:0;">Scrivi all'assistenza: rispondiamo dentro la conversazione.</p>
    </div>
  </div>
</div>

{% if errorText %}
  <div style="background:rgba(220,53,69,0.15);border:1px solid #dc3545;color:#ff6b77;padding:12px 18px;border-radius:12px;margin-bottom:20px;font-size:14px;">
    {{ errorText }}
  </div>
{% endif %}

{% if successText %}
  <div style="background:rgba(16,185,129,0.15);border:1px solid #10b981;color:#34d399;padding:12px 18px;border-radius:12px;margin-bottom:20px;font-size:14px;">
    {{ successText }}
  </div>
{% endif %}

<div class="ticket-grid" style="display:grid;grid-template-columns:1.15fr 0.85fr;gap:20px;margin-bottom:30px;">
  
  <!-- LEFT: APRI UN TICKET -->
  <div class="dash-card ticket-card" style="border-radius:18px;background:#0c121e;border:1px solid #1a2538;padding:26px 28px;">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:20px;height:20px;color:#10b981;">
        <path d="M3 9V7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2a3 3 0 0 0 0 6v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2a3 3 0 0 0 0-6Z"/><path d="M13 5v2M13 11v2M13 17v2"/>
      </svg>
      <h3 style="font-size:17px;font-weight:800;color:#fff;margin:0;">Apri un ticket</h3>
    </div>
    <p style="font-size:13.5px;color:#7b8ca6;margin:0 0 22px;line-height:1.5;">
      Descrivi il problema: ti rispondiamo qui dentro, riceverai la risposta in questa pagina.
    </p>

    <form method="post" action="/tickets">
      <div class="form-group mb-3" style="margin-bottom:16px;">
        <label for="ticket_subject" style="display:block;font-size:13px;font-weight:700;color:#cbd5e1;margin-bottom:8px;">
          Oggetto
        </label>
        <input type="text" class="form-control" id="ticket_subject" name="subject" required placeholder="Inserisci un oggetto chiaro..." value="{{ data['subject'] }}" style="width:100%;height:46px;padding:0 14px;background:#101726;border:1px solid #1e2c44;color:#fff;border-radius:10px;font-size:14px;">
      </div>

      <div class="form-group mb-4" style="margin-bottom:22px;">
        <label for="ticket_message" style="display:block;font-size:13px;font-weight:700;color:#cbd5e1;margin-bottom:8px;">
          Messaggio
        </label>
        <textarea class="form-control" id="ticket_message" name="message" rows="6" required placeholder="Descrivi il problema, includendo l'ID ordine se presente..." style="width:100%;padding:14px;background:#101726;border:1px solid #1e2c44;color:#fff;border-radius:10px;font-size:14px;line-height:1.5;resize:vertical;">{{ data['message'] }}</textarea>
      </div>

      <button type="submit" class="btn primary" style="width:100%;height:48px;background:linear-gradient(135deg, #10b981 0%, #059669 100%);border:none;border-radius:10px;color:#fff;font-weight:800;font-size:15px;cursor:pointer;box-shadow:0 8px 24px -6px rgba(16,185,129,0.55);transition:all 0.25s ease;">
        Invia ticket
      </button>
    </form>
  </div>

  <!-- RIGHT: I TUOI TICKET -->
  <div class="dash-card ticket-card" style="border-radius:18px;background:#0c121e;border:1px solid #1a2538;padding:26px 28px;">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:20px;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:20px;height:20px;color:#10b981;">
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
      </svg>
      <h3 style="font-size:17px;font-weight:800;color:#fff;margin:0;">I tuoi ticket</h3>
    </div>

    {% if ticketList|length == 0 %}
      <div style="text-align:center;padding:50px 20px;">
        <div style="width:60px;height:60px;border-radius:16px;background:rgba(123,140,166,0.08);border:1px dashed #22324d;display:inline-flex;align-items:center;justify-content:center;color:#7b8ca6;margin-bottom:16px;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:30px;height:30px;">
            <path d="M3 9V7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2a3 3 0 0 0 0 6v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2a3 3 0 0 0 0-6Z"/>
          </svg>
        </div>
        <h4 style="font-size:16px;font-weight:700;color:#fff;margin:0 0 6px;">Nessun ticket</h4>
        <p style="font-size:13.5px;color:#7b8ca6;margin:0;">Se hai bisogno di aiuto aprine uno qui a fianco.</p>
      </div>
    {% else %}
      <div class="ticket-list-wrapper" style="display:flex;flex-direction:column;gap:12px;">
        {% for ticket in ticketList %}
          <a href="/tickets/{{ ticket['ticket_id'] }}" style="display:block;padding:16px;border-radius:12px;background:#101726;border:1px solid #1e2c44;text-decoration:none;transition:all 0.2s ease;" onmouseover="this.style.borderColor='#10b981';this.style.transform='translateY(-2px)'" onmouseout="this.style.borderColor='#1e2c44';this.style.transform='none'">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
              <span style="font-size:12px;font-weight:700;color:#7b8ca6;">#{{ ticket['ticket_id'] }}</span>
              <span style="font-size:11px;font-weight:700;padding:3px 9px;border-radius:99px;background:rgba(16,185,129,0.12);color:#34d399;">
                {{ ticket['status'] }}
              </span>
            </div>
            <h5 style="font-size:14.5px;font-weight:700;color:#fff;margin:0 0 6px;">{{ ticket['subject'] }}</h5>
            <span style="font-size:12px;color:#7b8ca6;">{{ ticket['lastupdate_time'] }}</span>
          </a>
        {% endfor %}
      </div>
    {% endif %}

  </div>

</div>

<style>
  @media (max-width: 900px) {
    .ticket-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>

{% include 'footer.twig' %}

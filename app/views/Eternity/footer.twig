  function toggleSidebar() {
    var sidebar = document.getElementById('sidebar');
    if (sidebar) sidebar.classList.toggle('active');
  }

  function toggleTheme() {
    var cur = document.documentElement.dataset.theme || 'dark';
    var nxt = cur === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = nxt;
    try { localStorage.setItem('krazysmm.theme', nxt); } catch(e) {}
  }

  function toggleLangDropdown(e) {
    if (e) e.stopPropagation();
    var m = document.getElementById('langDropdownMenu');
    if (m) m.style.display = (m.style.display === 'block') ? 'none' : 'block';
  }

  function toggleLangDropdownPublic(e) {
    if (e) e.stopPropagation();
    var m = document.getElementById('langDropdownMenuPublic');
    if (m) m.style.display = (m.style.display === 'block') ? 'none' : 'block';
  }

  document.addEventListener('click', function(e) {
    var m1 = document.getElementById('langDropdownMenu');

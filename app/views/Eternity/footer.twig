  function selectLanguage(code) {
    try {
      localStorage.setItem('deepsmm_lang', code);
      document.cookie = "site_lang=" + code + ";path=/;max-age=31536000";
    } catch(e) {}
    
    // Apply client translations immediately
    applyDeepLanguage(code);

    // Call server to persist session and reload seamlessly
    var u = new URL(window.location.href);
    u.searchParams.set('lang', code);
    window.location.href = u.toString();
  }

  function applyDeepLanguage(code) {
    if (!DEEPSMM_I18N[code]) code = 'it';
    var dict = DEEPSMM_I18N[code];

    // Update Flag Buttons
    var info = LANG_FLAGS[code] || LANG_FLAGS.it;
    document.querySelectorAll('.lang-btn-current-flag').forEach(function(el) {
      el.textContent = info.flag;
    });
    document.querySelectorAll('.lang-btn-current-text').forEach(function(el) {
      el.textContent = info.name;
    });

    // Translate all elements with data-i18n
    document.querySelectorAll('[data-i18n]').forEach(function(el) {
      var key = el.getAttribute('data-i18n');
      if (dict[key]) {
        el.textContent = dict[key];
      }
    });

    // Update active state in dropdown menus
    document.querySelectorAll('.lang-opt-item').forEach(function(el) {
      var optLang = el.getAttribute('data-lang');
      if (optLang === code) {
        el.style.color = '#10b981';
        el.style.background = 'rgba(16,185,129,0.14)';
        el.style.fontWeight = '700';
      } else {
        el.style.color = '#cbd5e1';
        el.style.background = 'transparent';
        el.style.fontWeight = '500';
      }
    });
  }

  // Run on load
  document.addEventListener('DOMContentLoaded', function() {
    var stored = null;
    try { stored = localStorage.getItem('deepsmm_lang'); } catch(e) {}
    var urlParams = new URLSearchParams(window.location.search);
    var langParam = urlParams.get('lang');
    var activeLang = langParam || stored || '{{ active_lang_code|default("it") }}';
    if (!DEEPSMM_I18N[activeLang]) activeLang = 'it';
    applyDeepLanguage(activeLang);
  });
</script>

</body>
</html>

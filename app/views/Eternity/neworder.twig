<script>
  var originalCategoriesList = [];
  var currentSelectedRate = 0.5;

  document.addEventListener('DOMContentLoaded', function() {
    var catSel = document.getElementById('neworder_category');
    if (catSel) {
      for (var i = 0; i < catSel.options.length; i++) {
        originalCategoriesList.push({
          value: catSel.options[i].value,
          text: catSel.options[i].text
        });
      }
    }
    // Load first category services
    onCategorySelectChange();
  });

  function filterPlatformKrazy(platform, btn) {
    document.querySelectorAll('.ko-pill').forEach(function(b){ b.classList.remove('active'); });
    if (btn) btn.classList.add('active');

    var catSel = document.getElementById('neworder_category');
    if (!catSel || !originalCategoriesList.length) return;

    catSel.innerHTML = '';
    var pLower = platform.toLowerCase();
    var matchCount = 0;

    originalCategoriesList.forEach(function(item) {
      var itLower = item.text.toLowerCase();
      var matches = false;
      if (platform === 'Everything') {
        matches = true;
      } else if (platform === 'Others') {
        var mains = ['instagram', 'tiktok', 'youtube', 'facebook', 'twitter', 'telegram', 'spotify', 'traffic', 'linkedin', 'discord', 'snapchat', 'twitch', 'google', 'review'];
        matches = !mains.some(function(m){ return itLower.indexOf(m) !== -1; });
      } else {
        matches = itLower.indexOf(pLower) !== -1;
      }

      if (matches) {
        var opt = document.createElement('option');
        opt.value = item.value;
        opt.textContent = item.text;
        catSel.appendChild(opt);
        matchCount++;
      }
    });

    if (matchCount === 0) {
      var emptyOpt = document.createElement('option');
      emptyOpt.value = '';
      emptyOpt.textContent = 'Nessuna categoria per ' + platform;
      catSel.appendChild(emptyOpt);
    }

    onCategorySelectChange();
  }

  function handleLiveServiceSearch(term) {
    if (!term || term.trim() === '') return;
    term = term.toLowerCase().trim();
    var srvSel = document.getElementById('neworder_services');
    for (var i = 0; i < srvSel.options.length; i++) {
      if (srvSel.options[i].text.toLowerCase().indexOf(term) !== -1) {
        srvSel.selectedIndex = i;
        onServiceSelectChange();
        break;
      }
    }
  }

  function onCategorySelectChange() {
    var catId = document.getElementById('neworder_category').value;
    if (!catId) return;

    if (window.jQuery) {
      $.ajax({
        url: '/ajax_data',
        type: 'POST',
        data: { action: 'services_list', category: catId },
        success: function(resp) {
          try {
            var data = typeof resp === 'string' ? JSON.parse(resp) : resp;
            if (data && data.services) {
              $('#neworder_services').html(data.services);
              onServiceSelectChange();
            }
          } catch(e) {}
        }
      });
    }
  }

  function onServiceSelectChange() {
    var srvSel = document.getElementById('neworder_services');
    if (!srvSel || !srvSel.options.length || srvSel.selectedIndex < 0) return;

    var opt = srvSel.options[srvSel.selectedIndex];
    var text = opt.text || '';
    var srvId = opt.value;

    document.getElementById('cardServiceBadge').innerText = '#' + srvId;
    document.getElementById('cardServiceTitle').innerText = text.replace(/#\d+\s*/, '');

    // Extract rate if present in text
    var priceMatch = text.match(/\$\s*([0-9\.]+)/);
    if (priceMatch) {
      currentSelectedRate = parseFloat(priceMatch[1]);
      document.getElementById('cardServiceRate').innerText = '$' + currentSelectedRate.toFixed(4) + ' / 1000';
    } else {
      currentSelectedRate = 0.85;
      document.getElementById('cardServiceRate').innerText = '$0.8500 / 1000';
    }

    calculateOrderTotal();
  }

  function setOrderQuantity(val, btn) {
    document.querySelectorAll('.qty-pill').forEach(function(p){ p.classList.remove('active'); });
    if (btn) btn.classList.add('active');
    document.getElementById('order_quantity').value = val;
    calculateOrderTotal();
  }

  function calculateOrderTotal() {
    var qty = parseFloat(document.getElementById('order_quantity').value) || 0;
    var total = (currentSelectedRate * qty / 1000).toFixed(4);
    document.getElementById('orderTotalDisplay').innerText = '$' + total;
    document.getElementById('charge').value = total;
  }
</script>


{% include 'header.twig' %}

<!-- ==================== NEW ORDER PAGE (KrazySMM Full Style) ==================== -->
<div class="dash-head-section" style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;flex-wrap:wrap;gap:16px;">
  <div style="display:flex;align-items:center;gap:14px;">
    <div style="width:44px;height:44px;border-radius:12px;background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.25);display:flex;align-items:center;justify-content:center;color:#10b981;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width:20px;height:20px;">
        <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
      </svg>
    </div>
    <div>
      <h1 style="font-size:22px;font-weight:800;color:#fff;margin:0 0 3px;">Nuovo ordine</h1>
      <p style="font-size:13.5px;color:#7b8ca6;margin:0;">Scegli la piattaforma, incolla il link e parti in pochi secondi.</p>
    </div>
  </div>

  <a href="/services" class="btn" style="display:inline-flex;align-items:center;gap:8px;height:42px;padding:0 20px;border-radius:10px;background:#101726;border:1px solid #1e2c44;color:#fff;font-weight:700;font-size:13.5px;text-decoration:none;transition:all 0.2s ease;" onmouseover="this.style.borderColor='#10b981'" onmouseout="this.style.borderColor='#1e2c44'">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;color:#10b981;">
      <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/>
      <line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
    </svg>
    <span>Tutti i servizi</span>
  </a>
</div>

<!-- ==================== BANNER RICARICA DISCORD ==================== -->
<div style="background:linear-gradient(90deg, rgba(88,101,242,0.18) 0%, rgba(16,185,129,0.18) 100%);border:1px solid rgba(16,185,129,0.35);padding:16px 22px;border-radius:16px;margin-bottom:20px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:14px;">
  <div style="display:flex;align-items:center;gap:14px;">
    <div style="width:40px;height:40px;border-radius:12px;background:#5865F2;display:flex;align-items:center;justify-content:center;color:#fff;font-size:20px;box-shadow:0 6px 18px rgba(88,101,242,0.4);flex-shrink:0;">
      <i class="fab fa-discord"></i>
    </div>
    <div>
      <h4 style="font-size:14.5px;font-weight:800;color:#fff;margin:0 0 2px;">Hai bisogno di ricaricare il saldo?</h4>
      <p style="font-size:12.5px;color:#cbd5e1;margin:0;">Entra nel Discord, apri un ticket e paga l'importo desiderato (es. 10€): un admin caricherà subito il saldo sul tuo account per ordinare!</p>
    </div>
  </div>
  <div style="display:flex;align-items:center;gap:10px;">
    <a href="/addfunds" class="btn" style="height:38px;padding:0 16px;border-radius:10px;background:linear-gradient(135deg, #10b981 0%, #059669 100%);color:#fff;font-weight:800;font-size:13px;display:inline-flex;align-items:center;gap:6px;text-decoration:none;box-shadow:0 4px 12px rgba(16,185,129,0.4);">
      <i class="fas fa-wallet"></i> Ricarica Saldo
    </a>
    <a href="https://discord.gg/" target="_blank" rel="noopener" class="btn" style="height:38px;padding:0 16px;border-radius:10px;background:#5865F2;color:#fff;font-weight:800;font-size:13px;display:inline-flex;align-items:center;gap:6px;text-decoration:none;box-shadow:0 4px 12px rgba(88,101,242,0.4);">
      <i class="fab fa-discord"></i> Apri Ticket Discord
    </a>
  </div>
</div>

<!-- ==================== PLATFORMS SELECTOR PILLS WITH BADGES (Screenshot 13) ==================== -->

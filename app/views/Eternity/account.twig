{% include 'header.twig' %}

<!-- ==================== ACCOUNT PAGE (KrazySMM Green Style) ==================== -->
<div class="dash-head-section" style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;flex-wrap:wrap;gap:16px;">
  <div style="display:flex;align-items:center;gap:14px;">
    <div style="width:44px;height:44px;border-radius:12px;background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.25);display:flex;align-items:center;justify-content:center;color:#10b981;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:22px;height:22px;">
        <circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>
      </svg>
    </div>
    <div>
      <h1 style="font-size:22px;font-weight:800;color:#fff;margin:0 0 3px;">Account</h1>
      <p style="font-size:13.5px;color:#7b8ca6;margin:0;">Dati, password, chiave API e dispositivi collegati.</p>
    </div>
  </div>
</div>

{% if errorText %}
  <div style="background:rgba(220,53,69,0.15);border:1px solid #dc3545;color:#ff6b77;padding:12px 18px;border-radius:12px;margin-bottom:20px;font-size:14px;">
    {{ errorText }}
  </div>
{% endif %}

{% if successText %}
  <div style="background:rgba(16,185,129,0.15);border:1px solid #10b981;color:#34d399;padding:12px 18px;border-radius:12px;margin-bottom:20px;font-size:14px;">
    {{ successText }}
  </div>
{% endif %}

<!-- ROW 1: I TUOI DATI & CAMBIA PASSWORD -->
<div class="account-grid-row" style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;">
  
  <!-- CARD 1: I TUOI DATI -->
  <div class="dash-card" style="border-radius:18px;background:#0c121e;border:1px solid #1a2538;padding:26px 28px;">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:20px;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:20px;height:20px;color:#10b981;">
        <circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>
      </svg>
      <h3 style="font-size:17px;font-weight:800;color:#fff;margin:0;">I tuoi dati</h3>
    </div>

    <!-- User Profile Strip -->
    <div style="display:flex;align-items:center;gap:16px;padding:16px;border-radius:14px;background:#101726;border:1px solid #1e2c44;margin-bottom:20px;">
      <div style="width:52px;height:52px;border-radius:14px;background:linear-gradient(135deg, #10b981, #059669);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;font-size:18px;flex-shrink:0;box-shadow:0 6px 16px -4px rgba(16,185,129,0.5);">
        {{ user['username']|slice(0, 2)|upper }}
      </div>
      <div style="min-width:0;">
        <h4 style="font-size:16px;font-weight:800;color:#fff;margin:0 0 3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{{ user['username'] }}</h4>
        <span style="font-size:13px;color:#7b8ca6;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{{ user['email'] }}</span>
      </div>
    </div>

    <!-- Stats Table Rows -->
    <div style="display:flex;flex-direction:column;gap:12px;">
      <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 14px;border-radius:10px;background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.04);">
        <span style="font-size:13.5px;color:#7b8ca6;display:flex;align-items:center;gap:8px;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;color:#10b981;"><circle cx="12" cy="12" r="9"/><path d="M12 7v10M9.5 9.5h4a1.8 1.8 0 0 1 0 3.6h-3a1.8 1.8 0 0 0 0 3.6h4"/></svg>
          Saldo
        </span>
        <b style="font-size:15px;color:#10b981;font-weight:800;">{{ user['balance'] ?: '$0.0000' }}</b>
      </div>

      <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 14px;border-radius:10px;background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.04);">
        <span style="font-size:13.5px;color:#7b8ca6;display:flex;align-items:center;gap:8px;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;color:#a855f7;"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
          Speso
        </span>
        <b style="font-size:15px;color:#fff;font-weight:800;">{{ user['spent'] ?: '$0.0000' }}</b>
      </div>

      <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 14px;border-radius:10px;background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.04);">
        <span style="font-size:13.5px;color:#7b8ca6;display:flex;align-items:center;gap:8px;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;color:#06b6d4;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          Registrato
        </span>
        <b style="font-size:13.5px;color:#94a3b8;font-weight:600;">{{ user['register_date'] }}</b>
      </div>
    </div>
  </div>

  <!-- CARD 2: CAMBIA PASSWORD -->
  <div class="dash-card" style="border-radius:18px;background:#0c121e;border:1px solid #1a2538;padding:26px 28px;">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:20px;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:20px;height:20px;color:#10b981;">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
      <h3 style="font-size:17px;font-weight:800;color:#fff;margin:0;">Cambia password</h3>
    </div>

    <form method="post" action="/account">
      <div class="form-group mb-3" style="margin-bottom:16px;">
        <label for="current_password" style="display:block;font-size:13px;font-weight:700;color:#cbd5e1;margin-bottom:8px;">
          Password attuale
        </label>
        <div style="position:relative;">
          <i class="fas fa-lock" style="position:absolute;left:14px;top:50%;transform:translateY(-50%);color:#7b8ca6;font-size:13px;"></i>
          <input type="password" class="form-control" id="current_password" name="current_password" required placeholder="Inserisci la password attuale..." style="width:100%;height:46px;padding:0 14px 0 40px;background:#101726;border:1px solid #1e2c44;color:#fff;border-radius:10px;font-size:14px;">
        </div>
      </div>

      <div class="form-group mb-3" style="margin-bottom:16px;">
        <label for="new_password" style="display:block;font-size:13px;font-weight:700;color:#cbd5e1;margin-bottom:8px;">
          Nuova password
        </label>
        <div style="position:relative;">
          <i class="fas fa-key" style="position:absolute;left:14px;top:50%;transform:translateY(-50%);color:#7b8ca6;font-size:13px;"></i>
          <input type="password" class="form-control" id="new_password" name="password" required placeholder="Minimo 8 caratteri..." style="width:100%;height:46px;padding:0 14px 0 40px;background:#101726;border:1px solid #1e2c44;color:#fff;border-radius:10px;font-size:14px;">
        </div>
      </div>

      <div class="form-group mb-4" style="margin-bottom:20px;">
        <label for="confirm_password" style="display:block;font-size:13px;font-weight:700;color:#cbd5e1;margin-bottom:8px;">
          Ripeti nuova password
        </label>
        <div style="position:relative;">
          <i class="fas fa-shield-alt" style="position:absolute;left:14px;top:50%;transform:translateY(-50%);color:#7b8ca6;font-size:13px;"></i>
          <input type="password" class="form-control" id="confirm_password" name="confirm_password" required placeholder="Ripeti la nuova password..." style="width:100%;height:46px;padding:0 14px 0 40px;background:#101726;border:1px solid #1e2c44;color:#fff;border-radius:10px;font-size:14px;">
        </div>
      </div>

      <button type="submit" class="btn primary" style="width:100%;height:46px;background:linear-gradient(135deg, #10b981 0%, #059669 100%);border:none;border-radius:10px;color:#fff;font-weight:800;font-size:14.5px;cursor:pointer;box-shadow:0 8px 24px -6px rgba(16,185,129,0.55);transition:all 0.25s ease;">
        Aggiorna password
      </button>
    </form>
  </div>

</div>

<!-- ROW 2: BOT TELEGRAM (Full width, Green accent) -->
<div class="dash-card" style="border-radius:18px;background:#0c121e;border:1px solid #1a2538;padding:26px 28px;margin-bottom:20px;">
  <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px;">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:20px;height:20px;color:#10b981;">
      <path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/>
    </svg>
    <h3 style="font-size:17px;font-weight:800;color:#fff;margin:0;">Bot Telegram</h3>
  </div>
  <p style="font-size:13.5px;color:#7b8ca6;margin:0 0 16px;">
    Collega il tuo account e ordina dal bot: stesso saldo, stessi servizi, dal telefono.
  </p>

  <ul style="list-style:none;padding:0;margin:0 0 22px;display:flex;flex-direction:column;gap:8px;font-size:13.5px;color:#94a3b8;">
    <li style="display:flex;align-items:center;gap:8px;">
      <span style="width:6px;height:6px;border-radius:50%;background:#10b981;"></span>
      Premi il pulsante: si apre il bot su Telegram.
    </li>
    <li style="display:flex;align-items:center;gap:8px;">
      <span style="width:6px;height:6px;border-radius:50%;background:#10b981;"></span>
      Su Telegram premi Avvia: l'account si collega da solo.
    </li>
    <li style="display:flex;align-items:center;gap:8px;">
      <span style="width:6px;height:6px;border-radius:50%;background:#10b981;"></span>
      Fatto: ordini, saldo e ricariche anche dal bot.
    </li>
  </ul>

  <a href="https://t.me/krazysmm_bot" target="_blank" rel="noopener" class="btn primary" style="display:inline-flex;align-items:center;justify-content:center;gap:10px;width:100%;height:46px;border-radius:10px;background:linear-gradient(135deg, #10b981 0%, #059669 100%);color:#fff;font-weight:800;font-size:14.5px;text-decoration:none;box-shadow:0 8px 24px -6px rgba(16,185,129,0.55);transition:all 0.25s ease;">
    <i class="fab fa-telegram-plane" style="font-size:18px;"></i>
    <span>Collega Telegram</span>
  </a>
</div>

<!-- ROW 3: LA TUA CHIAVE API -->
<div class="dash-card" style="border-radius:18px;background:#0c121e;border:1px solid #1a2538;padding:26px 28px;margin-bottom:20px;">
  <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px;">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:20px;height:20px;color:#10b981;">
      <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
    </svg>
    <h3 style="font-size:17px;font-weight:800;color:#fff;margin:0;">La tua chiave API</h3>
  </div>
  <p style="font-size:13.5px;color:#7b8ca6;margin:0 0 18px;">
    Tienila segreta: chi la possiede può ordinare con il tuo saldo. Se pensi sia finita nelle mani sbagliate, rigenerala o revocala.
  </p>

  {% if user['apikey'] %}
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:18px;">
      <input type="text" readonly value="{{ user['apikey'] }}" id="apiKeyVal" style="flex:1;height:46px;padding:0 14px;background:#101726;border:1px solid #1e2c44;color:#10b981;border-radius:10px;font-family:monospace;font-size:14px;font-weight:700;">
      <button type="button" onclick="navigator.clipboard.writeText('{{ user['apikey'] }}');alert('Chiave API copiata!');" class="btn" style="height:46px;padding:0 18px;border-radius:10px;background:#101726;border:1px solid #1e2c44;color:#fff;font-weight:700;font-size:13px;display:flex;align-items:center;gap:6px;">
        <i class="far fa-copy"></i>
        <span>Copia</span>
      </button>
    </div>
  {% endif %}

  <a href="/account/newapikey" class="btn primary" style="display:inline-flex;align-items:center;justify-content:center;gap:8px;width:100%;height:46px;border-radius:10px;background:linear-gradient(135deg, #10b981 0%, #059669 100%);color:#fff;font-weight:800;font-size:14.5px;text-decoration:none;box-shadow:0 8px 24px -6px rgba(16,185,129,0.55);transition:all 0.25s ease;">
    <i class="fas fa-plus"></i>
    <span>Genera la chiave API</span>
  </a>
</div>

<!-- ROW 4: SESSIONI APERTE -->
<div class="dash-card" style="border-radius:18px;background:#0c121e;border:1px solid #1a2538;padding:26px 28px;margin-bottom:30px;">
  <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px;">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:20px;height:20px;color:#10b981;">
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
    </svg>
    <h3 style="font-size:17px;font-weight:800;color:#fff;margin:0;">Sessioni aperte</h3>
  </div>
  <p style="font-size:13.5px;color:#7b8ca6;margin:0 0 18px;">
    I dispositivi da cui il tuo account è collegato in questo momento.
  </p>

  <div style="display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-radius:12px;background:#101726;border:1px solid #1e2c44;flex-wrap:wrap;gap:12px;">
    <div style="display:flex;align-items:center;gap:10px;">
      <div style="width:22px;height:22px;border-radius:50%;background:rgba(16,185,129,0.15);display:flex;align-items:center;justify-content:center;color:#10b981;">
        <i class="fas fa-check" style="font-size:11px;"></i>
      </div>
      <b style="font-size:14px;color:#fff;font-family:monospace;">{{ user['login_ip'] ?: '127.0.0.1' }}</b>
      <span style="font-size:11px;font-weight:800;padding:2px 8px;border-radius:99px;background:rgba(16,185,129,0.15);color:#34d399;letter-spacing:0.5px;">
        QUESTO DISPOSITIVO
      </span>
    </div>

    <div style="font-size:12.5px;color:#7b8ca6;">
      Windows / Browser Web · {{ user['login_date'] ?: 'Adesso' }}
    </div>
  </div>
</div>

<style>
  @media (max-width: 900px) {
    .account-grid-row {
      grid-template-columns: 1fr !important;
    }
  }
</style>

{% include 'footer.twig' %}

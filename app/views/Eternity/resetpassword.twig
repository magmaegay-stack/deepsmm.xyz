{% include 'header.twig' %}
<style>
/* Divider Style */
.header-divider {
    width: 100%;
    height: 20px; /* Adjust height as needed */
    background-image: url('data:image/svg+xml;base64,'); /* Replace with the actual URL */
    background-size: cover;
    background-position: center;
    margin: 10px 0; /* Adjust spacing as needed */
}
/* Header divider */
.header-divider{
 height:37px !important;
 transform: rotateX(180deg);
 margin-top:-10px !important;
}
/* Import Google Fonts */
@import url("//fonts.googleapis.com/css2?family=Nunito:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&display=swap");

/* Column 6/12 */
.reset-password-form .col-lg-6{
 margin-top:-30px;
 font-family:'Nunito', sans-serif;
}

/* Label */
.well form label{
 text-transform:capitalize;
}


</style>
<div class="header-divider"></div>
   <div class="wrapper-content">
    <div class="wrapper-content__header">
          </div>
    <div class="wrapper-content__body">
      <!-- Main variables *content* -->
      <div id="block_338">
    <div class="reset-password-form">
        <div class="bg"></div>
        <div class="divider-top"></div>
        <div class="divider-bottom"></div>
        <div class="container">
            <div class="row reset-password-form__alignment">
                <div class="col-lg-6">
                    <div class="component_card">
                        <div class="card">
   
    <div class="col-md-12">

      {% if errorText %}
        <div class="alert alert-dismissible alert-danger">
          <button type="button" class="close" data-dismiss="alert">&times;</button>
          {{ errorText }}
        </div>
      {% endif %}
      {% if successText %}
        <div class="alert alert-dismissible alert-success">
          <button type="button" class="close" data-dismiss="alert">&times;</button>
          {{ successText }}
        </div>
      {% endif %}

      <div class="well">
        <form method="post" action="">

          <div class="form-group">
<label for="username" class="form-label">Enter your email</label>
<input type="text" class="form-control" name="user" value="{{ data['user'] }}" placeholder="johnsmith28@gmail.com">
</div>

          {% if captcha %}
            <div class="form-group">
              <div class="g-recaptcha" data-sitekey="{{ captchaKey }}"></div>
            </div>
          {% endif %}

            <button type="submit" class="btn btn-block btn-primary">{{ lang['resetpassword.button'] }}</button>
        </form>
      </div>
    </div>
  </div></div>

    </div></div></div>
</div></div>
</div>
{% include 'footer.twig' %}

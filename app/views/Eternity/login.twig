        {% if errorText %}
          <div style="background:rgba(220,53,69,0.15);border:1px solid #dc3545;color:#ff6b77;padding:12px 16px;border-radius:10px;margin-bottom:18px;font-size:13.5px;">
            {{ errorText }}
          </div>
        {% endif %}
        {% if successText %}
          <div style="background:rgba(16,185,129,0.15);border:1px solid #10b981;color:#34d399;padding:12px 16px;border-radius:10px;margin-bottom:18px;font-size:13.5px;">
            {{ successText }}
          </div>
        {% endif %}

        <form method="post" action="/">
          <div class="inpwrap" style="position:relative;margin-bottom:14px;">
            <i class="fas fa-user" style="position:absolute;left:14px;top:50%;transform:translateY(-50%);color:#7b8ca6;font-size:14px;"></i>
            <input name="username" type="text" placeholder="Username o email" required value="{{ data['username'] }}" style="width:100%;height:46px;padding:0 14px 0 42px;background:#101726;border:1px solid #1e2c44;color:#fff;border-radius:10px;font-size:14px;">
          </div>

          <div class="inpwrap" style="position:relative;margin-bottom:16px;">
            <i class="fas fa-lock" style="position:absolute;left:14px;top:50%;transform:translateY(-50%);color:#7b8ca6;font-size:14px;"></i>
            <input name="password" type="password" placeholder="Password" required style="width:100%;height:46px;padding:0 14px 0 42px;background:#101726;border:1px solid #1e2c44;color:#fff;border-radius:10px;font-size:14px;">
          </div>

          {% if captcha %}
            <div class="form-group mb-3"><div class="g-recaptcha" data-sitekey="{{ captchaKey }}"></div></div>
          {% endif %}

          <button class="btn primary big" type="submit" style="width:100%;height:48px;background:#10b981;border:none;border-radius:10px;color:#fff;font-weight:700;font-size:15px;cursor:pointer;box-shadow:0 6px 20px rgba(16,185,129,0.4);transition:background 0.15s, transform 0.15s;">Accedi</button>
        </form>

        <p class="hintline" style="display:flex;align-items:center;gap:8px;font-size:12.5px;color:#7b8ca6;margin:16px 0 0;">
          <i class="fas fa-shield-alt" style="color:#10b981;"></i>
          Puoi entrare indifferentemente con il tuo username o con la tua email.
        </p>

        <p class="swap" style="font-size:13.5px;color:#7b8ca6;margin:18px 0 0;text-align:center;">
          <a href="/resetpassword" style="color:#10b981;font-weight:600;">Password dimenticata?</a>
        </p>

        <p class="swap" style="font-size:13.5px;color:#7b8ca6;margin:8px 0 0;text-align:center;">
          Non hai un account? <a href="/signup" style="color:#10b981;font-weight:700;">Registrati</a>
        </p>
      </section>

    </div>
  </div>
</div>

<script>
  function openLoginModal(e) {
    if (e) e.preventDefault();
    document.getElementById('loginModal').classList.add('active');
  }

  function closeLoginModal() {
    document.getElementById('loginModal').classList.remove('active');
  }

  // Check URL params or path on load
  document.addEventListener('DOMContentLoaded', function() {
    if (window.location.hash === '#login' || window.location.pathname.indexOf('/auth') !== -1 || window.location.pathname.indexOf('/login') !== -1) {
      document.getElementById('loginModal').classList.add('active');
    }
  });

  // Price calculator live logic
  function updateCalc() {
    var sel = document.getElementById('calcSvc');
    var qty = parseFloat(document.getElementById('calcQty').value) || 0;
    var opt = sel.options[sel.selectedIndex];
    var rate = parseFloat(opt.getAttribute('data-rate')) || 0;
    var min = opt.getAttribute('data-min');
    var max = opt.getAttribute('data-max');
    
    var total = (rate * qty / 1000).toFixed(4);
    document.getElementById('calcOut').innerText = '$' + total;
    document.getElementById('calcNote').innerText = 'Questo servizio va da ' + Number(min).toLocaleString() + ' a ' + Number(max).toLocaleString() + ' unità.';
  }
</script>


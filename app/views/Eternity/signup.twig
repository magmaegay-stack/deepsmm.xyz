{% include 'header.twig' %}

<div class="auth-page-wrapper" style="min-height: calc(100vh - 120px); display: flex; align-items: center; justify-content: center; padding: 40px 16px;">
  <div class="authsplit" style="position:relative; width: 100%; max-width: 940px; display: grid; grid-template-columns: 1fr 1.05fr; border-radius: 20px; overflow: hidden; background: #0c121e; border: 1px solid #1a2538; box-shadow: 0 24px 60px rgba(0,0,0,0.65);">
    
    <!-- LEFT SIDE: EMERALD GREEN GRADIENT HERO (Screenshot 5 / KrazySMM style) -->
    <section class="authhero" style="background: linear-gradient(135deg, #10b981 0%, #059669 50%, #047857 100%); padding: 44px 38px; display: flex; flex-direction: column; justify-content: space-between; position: relative; overflow: hidden; color: #fff;">
      <div style="position:absolute;top:-80px;right:-80px;width:240px;height:240px;border-radius:50%;background:rgba(255,255,255,0.08);filter:blur(30px);pointer-events:none;"></div>
      <div style="position:absolute;bottom:-60px;left:-60px;width:220px;height:220px;border-radius:50%;background:rgba(0,0,0,0.15);filter:blur(25px);pointer-events:none;"></div>

      <div style="position:relative;z-index:2;">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:30px;">
          <img src="/public/Eternity/logo.png" alt="KrazySMM" style="height:36px;width:auto;object-fit:contain;filter:drop-shadow(0 2px 8px rgba(0,0,0,0.2));">
        </div>

        <h2 style="font-size:27px;font-weight:800;line-height:1.25;margin:0 0 12px;color:#fff;">Il pannello SMM più veloce</h2>
        <p style="font-size:14px;color:rgba(255,255,255,0.85);line-height:1.55;margin:0 0 28px;">Follower, like, visualizzazioni e molto altro su tutte le piattaforme, a prezzi da rivenditore.</p>

        <ul class="authfeats" style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:16px;">
          <li style="display:flex;align-items:flex-start;gap:14px;">
            <div style="width:34px;height:34px;border-radius:10px;background:rgba(255,255,255,0.18);backdrop-filter:blur(10px);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <i class="fas fa-bolt" style="color:#fff;font-size:14px;"></i>
            </div>
            <div>
              <strong style="display:block;font-size:14px;font-weight:700;color:#fff;">Consegna istantanea</strong>
              <small style="color:rgba(255,255,255,0.8);font-size:12.5px;">Gli ordini partono in pochi secondi</small>
            </div>
          </li>
          <li style="display:flex;align-items:flex-start;gap:14px;">
            <div style="width:34px;height:34px;border-radius:10px;background:rgba(255,255,255,0.18);backdrop-filter:blur(10px);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <i class="fas fa-shield-alt" style="color:#fff;font-size:14px;"></i>
            </div>
            <div>
              <strong style="display:block;font-size:14px;font-weight:700;color:#fff;">Servizi garantiti</strong>
              <small style="color:rgba(255,255,255,0.8);font-size:12.5px;">Refill e supporto su tutti i pacchetti</small>
            </div>
          </li>
          <li style="display:flex;align-items:flex-start;gap:14px;">
            <div style="width:34px;height:34px;border-radius:10px;background:rgba(255,255,255,0.18);backdrop-filter:blur(10px);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <i class="fas fa-tags" style="color:#fff;font-size:14px;"></i>
            </div>
            <div>
              <strong style="display:block;font-size:14px;font-weight:700;color:#fff;">Prezzi trasparenti</strong>
              <small style="color:rgba(255,255,255,0.8);font-size:12.5px;">Nessun costo nascosto, paghi solo quello che vedi</small>
            </div>
          </li>
        </ul>
      </div>

      <!-- Social platform row -->
      <div style="display:flex;align-items:center;gap:8px;padding-top:28px;border-top:1px solid rgba(255,255,255,0.18);position:relative;z-index:2;">
        <span class="plat md" style="background:rgba(255,255,255,0.95);border-radius:8px;padding:6px;display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;color:#E1306C;"><i class="fab fa-instagram"></i></span>
        <span class="plat md" style="background:rgba(255,255,255,0.95);border-radius:8px;padding:6px;display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;color:#000;"><i class="fab fa-tiktok"></i></span>
        <span class="plat md" style="background:rgba(255,255,255,0.95);border-radius:8px;padding:6px;display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;color:#FF0000;"><i class="fab fa-youtube"></i></span>
        <span class="plat md" style="background:rgba(255,255,255,0.95);border-radius:8px;padding:6px;display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;color:#0088cc;"><i class="fab fa-telegram-plane"></i></span>
        <span class="plat md" style="background:rgba(255,255,255,0.95);border-radius:8px;padding:6px;display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;color:#000;"><i class="fab fa-x-twitter"></i></span>
        <span class="plat md" style="background:rgba(255,255,255,0.95);border-radius:8px;padding:6px;display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;color:#1877F2;"><i class="fab fa-facebook-f"></i></span>
        <span class="plat md" style="background:rgba(255,255,255,0.95);border-radius:8px;padding:6px;display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;color:#1ED760;"><i class="fab fa-spotify"></i></span>
      </div>
    </section>

    <!-- RIGHT SIDE: DARK REGISTRATION FORM -->
    <section class="authcard" style="padding:40px 36px;display:flex;flex-direction:column;justify-content:center;background:#0c121e;">
      <h1 style="font-size:26px;font-weight:800;color:#fff;margin:0 0 6px;">Crea il tuo account</h1>
      <p class="sub" style="color:#7b8ca6;margin:0 0 20px;font-size:14px;">Registrati in meno di un minuto, senza costi fissi.</p>

      {% if errorText %}
        <div style="background:rgba(220,53,69,0.15);border:1px solid #dc3545;color:#ff6b77;padding:12px 16px;border-radius:10px;margin-bottom:18px;font-size:13.5px;">
          {{ errorText }}
        </div>
      {% endif %}
      {% if successText %}
        <div style="background:rgba(16,185,129,0.15);border:1px solid #10b981;color:#34d399;padding:12px 16px;border-radius:10px;margin-bottom:18px;font-size:13.5px;">
          {{ successText }}
        </div>
      {% endif %}

      <form action="/signup" method="post">
        <div style="margin-bottom:14px;">
          <div class="inpwrap" style="position:relative;">
            <i class="fas fa-user" style="position:absolute;left:14px;top:50%;transform:translateY(-50%);color:#7b8ca6;font-size:13px;"></i>
            <input type="text" name="username" placeholder="Nome utente" value="{{ data['username'] }}" required style="width:100%;height:46px;padding:0 12px 0 38px;background:#101726;border:1px solid #1e2c44;color:#fff;border-radius:12px;font-size:14px;box-sizing:border-box;">
          </div>
        </div>

        <div style="margin-bottom:14px;">
          <div class="inpwrap" style="position:relative;">
            <i class="fas fa-envelope" style="position:absolute;left:14px;top:50%;transform:translateY(-50%);color:#7b8ca6;font-size:13px;"></i>
            <input type="email" name="email" placeholder="Indirizzo Email" value="{{ data['email'] }}" required style="width:100%;height:46px;padding:0 12px 0 38px;background:#101726;border:1px solid #1e2c44;color:#fff;border-radius:12px;font-size:14px;box-sizing:border-box;">
          </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px;">
          <div class="inpwrap" style="position:relative;">
            <i class="fas fa-lock" style="position:absolute;left:14px;top:50%;transform:translateY(-50%);color:#7b8ca6;font-size:13px;"></i>
            <input type="password" name="password" placeholder="Password" required style="width:100%;height:46px;padding:0 12px 0 38px;background:#101726;border:1px solid #1e2c44;color:#fff;border-radius:12px;font-size:14px;box-sizing:border-box;">
          </div>
          <div class="inpwrap" style="position:relative;">
            <i class="fas fa-lock" style="position:absolute;left:14px;top:50%;transform:translateY(-50%);color:#7b8ca6;font-size:13px;"></i>
            <input type="password" name="password_again" placeholder="Ripeti Password" required style="width:100%;height:46px;padding:0 12px 0 38px;background:#101726;border:1px solid #1e2c44;color:#fff;border-radius:12px;font-size:14px;box-sizing:border-box;">
          </div>
        </div>

        <div style="display:flex;align-items:center;gap:10px;margin-bottom:18px;">
          <input type="checkbox" name="terms" value="1" id="termsCheck" required style="accent-color:#10b981;width:16px;height:16px;cursor:pointer;">
          <label for="termsCheck" style="font-size:12.5px;color:#7b8ca6;cursor:pointer;margin:0;">
            Accetto i <a href="/terms" style="color:#10b981;text-decoration:underline;">termini di servizio</a> e le condizioni.
          </label>
        </div>

        <button type="submit" style="width:100%;height:46px;background:#10b981;border:none;border-radius:10px;color:#fff;font-weight:700;font-size:15px;cursor:pointer;box-shadow:0 6px 20px rgba(16,185,129,0.4);transition:all 0.15s ease;">
          Crea account
        </button>
      </form>

      <p class="swap" style="font-size:13.5px;color:#7b8ca6;margin:18px 0 0;text-align:center;">
        Hai già un account? <a href="/login" style="color:#10b981;font-weight:700;">Accedi</a>
      </p>
    </section>

  </div>
</div>

<style>
  @media (max-width: 820px) {
    .authsplit {
      grid-template-columns: 1fr !important;
    }
    .authhero {
      display: none !important;
    }
  }
</style>

{% include 'footer.twig' %}

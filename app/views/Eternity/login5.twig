<script>
    function handleCredentialResponse(response) {
        if (!response.credential) {
            console.error("Google sign-in failed: No credential received.");
            return;
        }

        // Create or reuse a hidden form to send token
        let form = document.getElementById('googleLoginForm');
        if (!form) {
            form = document.createElement('form');
            form.method = 'POST';
            form.action = '';
            form.id = 'googleLoginForm';
            
            let input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'google_token';
            form.appendChild(input);
            
            document.body.appendChild(form);
        }

        // Set token value and submit
        form.querySelector('input[name="google_token"]').value = response.credential;
        form.submit();
    }
</script>

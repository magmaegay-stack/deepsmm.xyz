{% include 'header.twig' %}

<!-- ==================== ORDERS PAGE (KrazySMM Green Style) ==================== -->
<div class="dash-head-section" style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;flex-wrap:wrap;gap:16px;">
  <div style="display:flex;align-items:center;gap:14px;">
    <div style="width:44px;height:44px;border-radius:12px;background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.25);display:flex;align-items:center;justify-content:center;color:#10b981;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:22px;height:22px;">
        <path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z"/><path d="m4 7.5 8 4.5 8-4.5M12 12v9"/>
      </svg>
    </div>
    <div>
      <h1 style="font-size:22px;font-weight:800;color:#fff;margin:0 0 3px;">Ordini</h1>
      <p style="font-size:13.5px;color:#7b8ca6;margin:0;">Tutti i tuoi ordini con stato, avanzamento e azioni disponibili.</p>
    </div>
  </div>

  <a href="/neworder" class="btn primary" style="display:inline-flex;align-items:center;gap:8px;height:42px;padding:0 20px;border-radius:10px;background:linear-gradient(135deg, #10b981 0%, #059669 100%);color:#fff;font-weight:700;font-size:14px;box-shadow:0 8px 20px -6px rgba(16,185,129,0.6);text-decoration:none;">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;">
      <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
    </svg>
    <span>Nuovo ordine</span>
  </a>
</div>

<!-- ==================== FILTER TABS ROW ==================== -->
<div style="display:flex;align-items:center;gap:8px;margin-bottom:18px;flex-wrap:wrap;">
  <a href="/orders" class="order-tab-pill {% if not status or status == 'all' %}active{% endif %}">Tutti</a>
  <a href="/orders/pending" class="order-tab-pill {% if status == 'pending' %}active{% endif %}">In sospeso</a>
  <a href="/orders/inprogress" class="order-tab-pill {% if status == 'inprogress' %}active{% endif %}">In corso</a>
  <a href="/orders/completed" class="order-tab-pill {% if status == 'completed' %}active{% endif %}">Completato</a>
  <a href="/orders/partial" class="order-tab-pill {% if status == 'partial' %}active{% endif %}">Parziale</a>
  <a href="/orders/canceled" class="order-tab-pill {% if status == 'canceled' %}active{% endif %}">Annullato</a>
</div>

<!-- ==================== SEARCH BAR ==================== -->
<div style="margin-bottom:20px;">
  <form method="get" action="/orders" style="display:flex;align-items:center;gap:10px;">
    <div style="position:relative;flex:1;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position:absolute;left:14px;top:50%;transform:translateY(-50%);width:16px;height:16px;color:#7b8ca6;">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
      </svg>
      <input type="text" name="search" value="{{ search }}" placeholder="Cerca per ID, link o servizio..." style="width:100%;height:46px;padding:0 14px 0 42px;background:#101726;border:1px solid #1e2c44;color:#fff;border-radius:10px;font-size:14px;">
    </div>
    <button type="submit" class="btn primary" style="height:46px;padding:0 24px;border-radius:10px;background:linear-gradient(135deg, #10b981 0%, #059669 100%);color:#fff;font-weight:700;font-size:14px;border:none;cursor:pointer;box-shadow:0 6px 18px -4px rgba(16,185,129,0.5);">
      Cerca
    </button>
  </form>
</div>

<div style="font-size:13px;color:#7b8ca6;margin-bottom:14px;font-weight:600;">
  {{ orders|length }} ordini
</div>

<!-- ==================== ORDERS CONTAINER ==================== -->
<div class="dash-card" style="border-radius:18px;background:#0c121e;border:1px solid #1a2538;padding:24px 28px;margin-bottom:30px;">
  
  {% if orders|length == 0 %}
    <div style="text-align:center;padding:60px 16px;">
      <div style="width:60px;height:60px;border-radius:16px;background:rgba(123,140,166,0.08);border:1px dashed #22324d;display:inline-flex;align-items:center;justify-content:center;color:#7b8ca6;margin-bottom:16px;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:28px;height:28px;">
          <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
        </svg>
      </div>
      <h4 style="font-size:17px;font-weight:800;color:#fff;margin:0 0 6px;">Nessun ordine</h4>
      <p style="font-size:13.5px;color:#7b8ca6;margin:0 0 22px;">Quando invii un ordine lo trovi qui.</p>
      
      <a href="/neworder" style="display:inline-flex;align-items:center;justify-content:center;height:42px;padding:0 24px;border-radius:10px;background:linear-gradient(135deg, #10b981 0%, #059669 100%);color:#fff;font-weight:700;font-size:14px;text-decoration:none;box-shadow:0 8px 20px -6px rgba(16,185,129,0.55);transition:all 0.25s ease;">
        Crea il primo ordine
      </a>
    </div>
  {% else %}
    <div style="overflow-x:auto;">
      <table style="width:100%;border-collapse:collapse;font-size:13.5px;text-align:left;">
        <thead>
          <tr style="border-bottom:1px solid #1a2538;color:#7b8ca6;font-size:12px;text-transform:uppercase;letter-spacing:0.5px;">
            <th style="padding:12px 14px;">ID</th>
            <th style="padding:12px 14px;">Data</th>
            <th style="padding:12px 14px;">Link</th>
            <th style="padding:12px 14px;">Servizio</th>
            <th style="padding:12px 14px;">Quantità</th>
            <th style="padding:12px 14px;">Costo</th>
            <th style="padding:12px 14px;">Stato</th>
          </tr>
        </thead>
        <tbody>
          {% for order in orders %}
            <tr style="border-bottom:1px solid rgba(255,255,255,0.04);transition:all 0.2s ease;">
              <td style="padding:14px;font-weight:700;color:#7b8ca6;">#{{ order['order_id'] }}</td>
              <td style="padding:14px;color:#94a3b8;white-space:nowrap;">{{ order['order_create'] }}</td>
              <td style="padding:14px;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                <a href="{{ order['order_url'] }}" target="_blank" rel="noopener" style="color:#10b981;text-decoration:none;">{{ order['order_url'] }}</a>
              </td>
              <td style="padding:14px;color:#fff;font-weight:600;">{{ order['service_name'] }}</td>
              <td style="padding:14px;color:#94a3b8;">{{ order['order_quantity'] }}</td>
              <td style="padding:14px;color:#10b981;font-weight:700;">{{ order['order_charge'] }}</td>
              <td style="padding:14px;">
                <span style="display:inline-block;padding:4px 10px;border-radius:99px;font-size:11.5px;font-weight:700;background:rgba(16,185,129,0.14);color:#34d399;">
                  {{ order['status'] }}
                </span>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}

</div>

<style>
  .order-tab-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 7px 16px;
    border-radius: 8px;
    background: #101726;
    border: 1px solid #1e2c44;
    color: #cbd5e1;
    font-size: 13.5px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .order-tab-pill:hover {
    border-color: #10b981;
    color: #fff;
    transform: translateY(-2px);
  }
  .order-tab-pill.active {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%) !important;
    border-color: #10b981 !important;
    color: #fff !important;
    box-shadow: 0 4px 14px -2px rgba(16, 185, 129, 0.5) !important;
    font-weight: 700 !important;
  }
</style>

{% include 'footer.twig' %}

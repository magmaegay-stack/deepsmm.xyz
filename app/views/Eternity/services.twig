{% include 'header.twig' %}

<!-- ==================== SERVICES PAGE (KrazySMM Green Style) ==================== -->
<div class="dash-head-section" style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;flex-wrap:wrap;gap:16px;">
  <div style="display:flex;align-items:center;gap:14px;">
    <div style="width:44px;height:44px;border-radius:12px;background:rgba(16,185,129,0.12);border:1px solid rgba(16,185,129,0.25);display:flex;align-items:center;justify-content:center;color:#10b981;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:22px;height:22px;">
        <path d="M4 6h16M4 12h16M4 18h16"/><circle cx="2.5" cy="6" r="1.2"/><circle cx="2.5" cy="12" r="1.2"/><circle cx="2.5" cy="18" r="1.2"/>
      </svg>
    </div>
    <div>
      <h1 style="font-size:22px;font-weight:800;color:#fff;margin:0 0 3px;">Servizi</h1>
      <p style="font-size:13.5px;color:#7b8ca6;margin:0;">Il listino completo, con prezzo, minimo e massimo di ogni servizio.</p>
    </div>
  </div>

  <a href="/neworder" class="btn primary" style="display:inline-flex;align-items:center;gap:8px;height:42px;padding:0 20px;border-radius:10px;background:linear-gradient(135deg, #10b981 0%, #059669 100%);color:#fff;font-weight:700;font-size:14px;box-shadow:0 8px 20px -6px rgba(16,185,129,0.6);text-decoration:none;">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;">
      <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
    </svg>
    <span>Nuovo ordine</span>
  </a>
</div>

<!-- ==================== SEARCH & CATEGORY FILTER ROW (Screenshot 12) ==================== -->
<div style="display:grid;grid-template-columns:1.2fr 0.8fr auto;gap:12px;margin-bottom:18px;">
  <div style="position:relative;">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position:absolute;left:14px;top:50%;transform:translateY(-50%);width:16px;height:16px;color:#7b8ca6;">
      <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
    </svg>
    <input type="text" id="svcFilterSearch" onkeyup="filterServicesTable()" placeholder="Cerca per nome o ID servizio..." style="width:100%;height:46px;padding:0 14px 0 42px;background:#101726;border:1px solid #1e2c44;color:#fff;border-radius:10px;font-size:14px;">
  </div>

  <div>
    <select id="svcCategorySelect" onchange="filterServicesByCategory()" style="width:100%;height:46px;padding:0 14px;background:#101726;border:1px solid #1e2c44;color:#fff;border-radius:10px;font-size:14px;">
      <option value="All">Tutte le categorie</option>
      {% for category in serviceCategory %}
        <option value="{{ category['category_id'] }}">{{ category['category_name'] }}</option>
      {% endfor %}
    </select>
  </div>

  <button type="button" onclick="filterServicesTable()" class="btn primary" style="height:46px;padding:0 24px;border-radius:10px;background:linear-gradient(135deg, #10b981 0%, #059669 100%);color:#fff;font-weight:700;font-size:14px;border:none;cursor:pointer;box-shadow:0 6px 18px -4px rgba(16,185,129,0.5);">
    Cerca
  </button>
</div>

<!-- ==================== PLATFORMS TABS PILLS (Screenshot 12) ==================== -->
<div class="services-platforms-bar" style="display:flex;align-items:center;gap:8px;margin-bottom:18px;overflow-x:auto;padding-bottom:6px;">
  <button type="button" class="sp-pill active" data-platform="Everything" onclick="filterServicesByPill('Everything', this)">
    <span>Tutti</span>
  </button>
  <button type="button" class="sp-pill" data-platform="Instagram" onclick="filterServicesByPill('Instagram', this)">
    <i class="fab fa-instagram" style="color:#E1306C;"></i>
    <span>Instagram</span>
  </button>
  <button type="button" class="sp-pill" data-platform="TikTok" onclick="filterServicesByPill('TikTok', this)">
    <i class="fab fa-tiktok" style="color:#fff;"></i>
    <span>TikTok</span>
  </button>
  <button type="button" class="sp-pill" data-platform="Youtube" onclick="filterServicesByPill('Youtube', this)">
    <i class="fab fa-youtube" style="color:#FF0000;"></i>
    <span>YouTube</span>
  </button>
  <button type="button" class="sp-pill" data-platform="Telegram" onclick="filterServicesByPill('Telegram', this)">
    <i class="fab fa-telegram-plane" style="color:#229ED9;"></i>
    <span>Telegram</span>
  </button>
  <button type="button" class="sp-pill" data-platform="Twitter" onclick="filterServicesByPill('Twitter', this)">
    <i class="fab fa-x-twitter" style="color:#cbd5e1;"></i>
    <span>Twitter</span>
  </button>
  <button type="button" class="sp-pill" data-platform="Facebook" onclick="filterServicesByPill('Facebook', this)">
    <i class="fab fa-facebook-f" style="color:#1877F2;"></i>
    <span>Facebook</span>
  </button>
  <button type="button" class="sp-pill" data-platform="Spotify" onclick="filterServicesByPill('Spotify', this)">
    <i class="fab fa-spotify" style="color:#1ED760;"></i>
    <span>Spotify</span>
  </button>
  <button type="button" class="sp-pill" data-platform="Twitch" onclick="filterServicesByPill('Twitch', this)">
    <i class="fab fa-twitch" style="color:#9146FF;"></i>
    <span>Twitch</span>
  </button>
  <button type="button" class="sp-pill" data-platform="Discord" onclick="filterServicesByPill('Discord', this)">
    <i class="fab fa-discord" style="color:#5865F2;"></i>
    <span>Discord</span>
  </button>
  <button type="button" class="sp-pill" data-platform="Threads" onclick="filterServicesByPill('Threads', this)">
    <i class="fas fa-at" style="color:#fff;"></i>
    <span>Threads</span>
  </button>
  <button type="button" class="sp-pill" data-platform="Traffic" onclick="filterServicesByPill('Traffic', this)">
    <i class="fas fa-globe" style="color:#38bdf8;"></i>
    <span>Traffico</span>
  </button>
</div>

<!-- Counter Sub-Bar -->
<div style="font-size:13px;color:#7b8ca6;margin-bottom:18px;font-weight:600;">
  <span id="activeServicesCounter">Oltre 1480</span> servizi attivi · affina la ricerca
</div>

<!-- ==================== SERVICES TABLES WRAPPER (Screenshot 12) ==================== -->
<div id="servicesMasterList" style="display:flex;flex-direction:column;gap:20px;margin-bottom:30px;">
  
  {% for category in serviceCategory %}
    <div class="dash-card svc-cat-block" data-cat-id="{{ category['category_id'] }}" data-cat-name="{{ category['category_name']|lower }}" style="border-radius:18px;background:#0c121e;border:1px solid #1a2538;padding:20px 24px;">
      
      <!-- Category Header Bar (Screenshot 12) -->
      <div style="display:flex;align-items:center;justify-content:space-between;padding-bottom:14px;margin-bottom:14px;border-bottom:1px solid #162234;">
        <div style="display:flex;align-items:center;gap:12px;">
          <div style="width:34px;height:34px;border-radius:10px;background:rgba(16,185,129,0.12);display:flex;align-items:center;justify-content:center;color:#10b981;">
            {% if 'instagram' in category['category_name']|lower %}<i class="fab fa-instagram" style="color:#E1306C;"></i>
            {% elseif 'tiktok' in category['category_name']|lower %}<i class="fab fa-tiktok" style="color:#fff;"></i>
            {% elseif 'youtube' in category['category_name']|lower %}<i class="fab fa-youtube" style="color:#FF0000;"></i>
            {% elseif 'facebook' in category['category_name']|lower %}<i class="fab fa-facebook-f" style="color:#1877F2;"></i>
            {% elseif 'telegram' in category['category_name']|lower %}<i class="fab fa-telegram-plane" style="color:#229ED9;"></i>
            {% elseif 'spotify' in category['category_name']|lower %}<i class="fab fa-spotify" style="color:#1ED760;"></i>
            {% elseif 'twitter' in category['category_name']|lower or 'x -' in category['category_name']|lower %}<i class="fab fa-x-twitter" style="color:#cbd5e1;"></i>
            {% elseif 'discord' in category['category_name']|lower %}<i class="fab fa-discord" style="color:#5865F2;"></i>
            {% elseif 'twitch' in category['category_name']|lower %}<i class="fab fa-twitch" style="color:#9146FF;"></i>
            {% else %}<i class="fas fa-layer-group" style="color:#10b981;"></i>{% endif %}
          </div>
          <h3 style="font-size:16px;font-weight:800;color:#fff;margin:0;">{{ category['category_name'] }}</h3>
        </div>

        <span style="font-size:12px;font-weight:800;padding:2px 10px;border-radius:99px;background:rgba(255,255,255,0.06);color:#7b8ca6;">
          {{ category['services']|length }}
        </span>
      </div>

      <!-- Services Table (Screenshot 12) -->
      <div style="overflow-x:auto;">
        <table style="width:100%;border-collapse:collapse;font-size:13.5px;text-align:left;">
          <thead>
            <tr style="color:#7b8ca6;font-size:11.5px;text-transform:uppercase;letter-spacing:0.6px;border-bottom:1px solid #1a2538;">
              <th style="padding:10px 14px;width:70px;">ID</th>
              <th style="padding:10px 14px;">SERVIZIO</th>
              <th style="padding:10px 14px;width:120px;white-space:nowrap;">TASSO / 1000</th>
              <th style="padding:10px 14px;width:90px;">MIN</th>
              <th style="padding:10px 14px;width:110px;">MAX</th>
              <th style="padding:10px 14px;width:90px;text-align:right;"></th>
            </tr>
          </thead>
          <tbody>
            {% for srv in category['services'] %}
              <tr class="svc-table-row" data-srv-id="{{ srv['service_id'] }}" data-srv-title="{{ srv['service_name']|lower }}" style="border-bottom:1px solid rgba(255,255,255,0.035);transition:all 0.2s ease;">
                <td style="padding:12px 14px;color:#7b8ca6;font-weight:700;">{{ srv['service_id'] }}</td>
                <td style="padding:12px 14px;">
                  <div style="color:#fff;font-weight:600;line-height:1.4;margin-bottom:3px;">
                    {{ srv['service_name'] }}
                  </div>
                  <div style="display:flex;align-items:center;gap:6px;font-size:11px;color:#7b8ca6;">
                    {% if 'refill' in srv['service_name']|lower %}
                      <span style="color:#10b981;font-weight:700;">REFILL ATTIVO</span> ·
                    {% endif %}
                    <span>Consegna rapida</span>
                  </div>
                </td>
                <td style="padding:12px 14px;color:#10b981;font-weight:800;white-space:nowrap;font-size:14px;">
                  ${{ srv['service_price'] }}
                </td>
                <td style="padding:12px 14px;color:#94a3b8;">{{ srv['service_min'] }}</td>
                <td style="padding:12px 14px;color:#94a3b8;">{{ srv['service_max'] }}</td>
                <td style="padding:12px 14px;text-align:right;">
                  <a href="/neworder?service={{ srv['service_id'] }}" class="btn primary" style="display:inline-flex;align-items:center;justify-content:center;height:32px;padding:0 16px;border-radius:8px;background:linear-gradient(135deg, #10b981 0%, #059669 100%);color:#fff;font-weight:700;font-size:12.5px;text-decoration:none;box-shadow:0 4px 14px -3px rgba(16,185,129,0.5);transition:all 0.2s ease;">
                    Ordina
                  </a>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

    </div>
  {% endfor %}

</div>

<script>
  function filterServicesByPill(platform, btn) {
    document.querySelectorAll('.sp-pill').forEach(function(b){ b.classList.remove('active'); });
    if (btn) btn.classList.add('active');

    var pLower = platform.toLowerCase();
    var blocks = document.querySelectorAll('.svc-cat-block');

    blocks.forEach(function(blk) {
      var catName = blk.getAttribute('data-cat-name') || '';
      if (platform === 'Everything') {
        blk.style.display = '';
      } else {
        if (catName.indexOf(pLower) !== -1) {
          blk.style.display = '';
        } else {
          blk.style.display = 'none';
        }
      }
    });
  }

  function filterServicesByCategory() {
    var catId = document.getElementById('svcCategorySelect').value;
    var blocks = document.querySelectorAll('.svc-cat-block');
    blocks.forEach(function(blk) {
      if (catId === 'All' || blk.getAttribute('data-cat-id') === catId) {
        blk.style.display = '';
      } else {
        blk.style.display = 'none';
      }
    });
  }

  function filterServicesTable() {
    var term = document.getElementById('svcFilterSearch').value.toLowerCase().trim();
    var rows = document.querySelectorAll('.svc-table-row');
    rows.forEach(function(r) {
      var title = r.getAttribute('data-srv-title') || '';
      var id = r.getAttribute('data-srv-id') || '';
      if (!term || title.indexOf(term) !== -1 || id.indexOf(term) !== -1) {
        r.style.display = '';
      } else {
        r.style.display = 'none';
      }
    });
  }
</script>

<style>
  .sp-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 7px 14px;
    border-radius: 8px;
    background: #0d1524;
    border: 1px solid #1a263c;
    color: #cbd5e1;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.22s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .sp-pill:hover {
    border-color: #10b981;
    color: #fff;
    transform: translateY(-2px);
  }
  .sp-pill.active {
    background: rgba(16, 185, 129, 0.16) !important;
    border-color: #10b981 !important;
    color: #34d399 !important;
    box-shadow: 0 0 14px rgba(16, 185, 129, 0.35) !important;
    font-weight: 700 !important;
  }
  .svc-table-row:hover {
    background: rgba(16, 185, 129, 0.04) !important;
  }
</style>

{% include 'footer.twig' %}

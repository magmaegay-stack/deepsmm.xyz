<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
$(document).ready(function () {
    function showToast(message, type) {
      var $toast = $(".toast");
      $toast.removeClass("success error").addClass(type).html(message).addClass("show");
      $(".toast .close").on("click", function () {$toast.removeClass("show");}); 
      setTimeout(function () {$toast.removeClass("show");}, 6000);
    }
    $(".order-btn").on("click", function (e) {
        e.preventDefault();
        var $btn = $(this);
        var categories = $('[name="categories"]').val();
        var services = $('[name="services"]').val();
        var link = $('[name="link"]').val();  
        var quantity = $('[name="quantity"]').val();
        var comments = $('[name="comments"]').val();  
        $btn.html('<span class="loader"></span> Processing...').prop("disabled", true);
        $.post("neworder", {
            categories: categories,
            services: services,
            link: link,
            quantity: quantity,
            comments: comments
        }, function(response) {
            var $response = $("<div>").html(response); 
            var successMessage = $response.find(".alert.alert-dismissible.alert-success").html();
            var errorMessage = $response.find(".alert.alert-dismissible.alert-danger").html(); 
            if (errorMessage) {
                $btn.html('❌ Order Failed');
                showToast(errorMessage, "error");
                $('[name="link"]').val('');
                $('[name="quantity"]').val('');
                $('#charge').val('');
            } else if (successMessage){
                $btn.html('✔ Order Placed');
                showToast(successMessage, "success");
                $('[name="link"]').val('');
                $('[name="quantity"]').val('');
                $('#charge').val('');
            }
            setTimeout(function () {$btn.html('{{ lang["neworder.button"] }}').prop("disabled", false);}, 2300);
        }).fail(function() {
            showToast("Failed. Try again.", "error");
            $btn.html("Failed. Try again.");
            setTimeout(function () {$btn.html('{{ lang["neworder.button"] }}').prop("disabled", false);}, 2300);
        });
    });
});
</script>

{% include 'new-footer.twig' %}
<script>
$(document).ready(function () {
    // URL se params nikaalo
    const urlParams = new URLSearchParams(window.location.search);
    const categoryId = urlParams.get('category_id');
    const serviceId = urlParams.get('service_id');

    if (categoryId) {
        // Set category dropdown
        $('#neworder_category').val(categoryId).trigger('change');

        // Wait until services load (some panels load via AJAX)
        const interval = setInterval(function () {
            const $services = $('#neworder_services');
            if ($services.find('option').length > 1) {
                if (serviceId) {
                    $services.val(serviceId).trigger('change');
                }
                clearInterval(interval);
            }
        }, 300);
    }
});
</script>

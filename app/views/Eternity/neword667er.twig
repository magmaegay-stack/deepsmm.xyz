<style>
.body .badge {
    color: #fff;
}

.search-results {
  position: absolute;
 
  left: 0;
  z-index: 9999;
  width: 100%;
  background: #fff;
  max-height: 250px;
  overflow-y: auto;
  border: 1px solid #ddd;
  border-radius: 6px;
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
}

.search-results .dropdown-item {
  padding: 10px 15px;
  cursor: pointer;
  white-space: normal;
  border-bottom: 1px solid #eee;
}

.search-results .dropdown-item:hover {
  background-color: #f5f5f5;
}
#unique-dropdown {
    width: 93% !important;
}

    @media (max-width:991px){
        #unique-dropdown {
    width: 86% !important;
}}

</style>

<script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
<script>
function focusInputField() {
  $('#unique-input').focus();
}

function clearInput() {
  $('#unique-input').val('');
  $('#unique-dropdown').hide();
}

function serviceclicked(sid, cid) {
  $(`#neworder_category option[value="${cid}"]`).prop('selected', true).change();
  setTimeout(() => {
    $(`#neworder_services option[value="${sid}"]`).prop('selected', true).change();
    $('#unique-dropdown').hide();
  }, 1000);
}

$(document).ready(function () {
  $('#unique-input').on('input', function () {
    const inputValue = $(this).val().trim();
    if (!inputValue) {
      $('#unique-dropdown').hide();
      return;
    }

    // Show loading state
    $('#unique-dropdown').show().html(`
      <div class="dropdown-item">
        <span class="badge bg-primary">Searching</span>
      </div>
    `);

    // AJAX search
    $.ajax({
      type: 'POST',
      url: '/ajax_data', // ✅ Server must support this
      data: {
        action: 'service_search',
        search_term: inputValue
      },
      success: function (response) {
        console.log("AJAX Success:", response); // ✅ Check Console
        $('#unique-dropdown').html(response).show();
      },
      error: function (xhr) {
        console.error("AJAX Error:", xhr);
        $('#unique-dropdown').html(`
          <div class="dropdown-item text-danger">Error loading results</div>
        `).show();
      }
    });
  });
});
</script>



    


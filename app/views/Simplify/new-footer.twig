    {% if settings.whatsapp_status == 1 %}
  {% if settings.whatsapp_number and settings.whatsapp_position %}
  <script async src="https://d2mpatx37cqexb.cloudfront.net/delightchat-whatsapp-widget/embeds/embed.min.js"></script>
  <script>
    var wa_btnSetting = {
      "btnColor": "#16BE45",
      "ctaText": "",
      "cornerRadius": 40,
      "marginBottom": 20,
      "marginLeft": 20,
      "marginRight": 20,
      "btnPosition": "{{ settings.whatsapp_position }}",
      "whatsAppNumber": "{{ settings.whatsapp_number }}",
      "welcomeMessage": "{{ settings.whatsapp_welcome }}",
      "zIndex": 999999,
      "btnColorScheme": "light"
    };

    window.onload = () => {
      _waEmbed(wa_btnSetting);
    };
  </script>
  {% endif %}
{% endif %}
{% if settings.telegram_status == 1 %}
  {% if settings.telegram_username %}
    <a href="https://t.me/{{ settings.telegram_username }}" target="_blank"
      style="
      
      font-family:'Inter', sans-serif;
        position: fixed;
        {% if settings.telegram_position == 'left' %} left: 20px; {% else %} right: 20px; {% endif %}
        bottom: 20px;
        background-color: #0088cc;
        color: #fff;
        padding: 12px 18px;
        border-radius: 40px;
        text-decoration: none;
        z-index: 999999;
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2);
        font-size: 16px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: background-color 0.2s ease;
      "
      onmouseover="this.style.backgroundColor='#0077b5';"
      onmouseout="this.style.backgroundColor='#0088cc';">
      <img src="/img/integrations/telegram.svg" alt="Telegram" style="width: 20px; height: 20px;"> Support
    </a>
  {% endif %}
{% endif %}

<div class="wrapper-content__body">
    
  <!-- Main variables *content* -->
  <div id="block_api" class="pt-5 mt-2 ">
  <div class="block-api">
  <div class="container-fluid">
  <div class="row justify-content-center">
  <div class="col-lg-8">
         
  <div class="col-md-12g">
  <div class="well ">
      <br>
      <br>
      
  <div class="dashboard-content">
  <div class="head clearfix">
      <div class="card">
  <div class="content">
  {% if error %}
        <div class="alert alert-dismissible alert-danger">
          <button type="button" class="close" data-dismiss="alert">×</button>
          {{ errorText }}
        </div>
      {% endif %}
      {% if success %}
        <div class="alert alert-dismissible alert-success">
          <button type="button" class="close" data-dismiss="alert">×</button>
          {{ successText }}
        </div>
      {% endif %}
       {% if user['email_type'] == 1 %}
  <div class="alert alert-warning">
    <button type="button" class="close" data-dismiss="alert">×</button>
    <strong>Warning :</strong> Your email address is not verified. Please check your inbox for the verification email or <a href="confirm_email/resend" class="alert-link">click here to resend the verification email</a>.
  </div>
{% endif %}
<br>

      <h4 class="mb-3"><i class="fad fa-user-alt"></i> Account Details</h4>
      <div class="form-group">
          <label for="charge" class="control-label">{{ lang['account.username'] }}</label>
          <input type="text" class="form-control" value="{{ user['username'] }}" readonly>
        </div>

        

        <div class="form-group">
          <label for="charge" class="control-label">E-Mail</label>
          <input type="text" class="form-control" value="{{ user['email'] }}" readonly>
        </div>

{% if site['languages']|length > 1 %}
        <div class="well">
          <form method="post" action="account/change_lang">

            <div class="form-group">
              <label for="charge" class="control-label">{{ lang['account.changelang.title'] }}</label>
              <select class="form-control" name="lang">
                  {% for language in site['languages'] %}
                  <option {% if language["code"] == user["lang"] %} selected {% endif %} value="{{ language["code"] }}">{{ language["name"] }}</option>
                  {% endfor %}
              </select>
            </div>

            <button type="submit" class="btn btn-block btn-big-primary">{{ lang['account.changelang.button'] }}</button>
          </div>
                                </div>
                            </form>
                       </div>
  </div>
  </div>
{% endif %}

<button type="button" class="btn btn-block btn-big-primary" data-toggle="modal" data-target="#changeEmailModal">
    Change Email
</button>
<hr>
<!-- New Section for Changing WhatsApp Number -->
                        <h4 class="mb-3"><i class="fab fa-whatsapp"></i> Update WhatsApp Number</h4>
                        <div class="alert alert-info">
                          <p>To update your WhatsApp number, enter your new number with country code below and click "Save WhatsApp Number".</p>
                        </div>
                        <br>
                        <form method="post" action="account/change_phone">
                          <div class="form-group d-flex">
                            <label for="new_phone" class="control-label mr-2">New WhatsApp Number</label>
                            <div class="input-group w-100">
                             <input type="text" class="form-control" name="new_phone" placeholder="Enter your new phone number with country code (e.g., +1 123 456 7890)" value="{{ user['telephone'] }}" required>
    
    
                            </div>
                          </div>
                          <button type="submit" class="btn btn-block btn-big-primary">Save WhatsApp Number</button>
                        </form>
                        

  </div>
  </div>
  </div>
  </div>
  </div> 
  </div></div>
 

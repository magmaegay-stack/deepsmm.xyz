                      <h4 class="mb-3"><i class="fas fa-shield-alt"></i> Two-Factor Authentication</h4>
<div class="alert alert-info">
    <p>Enhance the security of your account by enabling two-factor authentication (2FA). Once enabled, you will receive a verification code via email each time you log in.</p>
</div>
<br>

<!-- Check if Two-Factor Authentication is enabled -->
{% if user['two_factor'] == 1 %}
    <form method="post" action="account/disable-2fa">
        <input type="hidden" name="action" value="disable">
        <button type="submit" class="btn btn-block btn-big-primary">Disable Two-Factor Authentication</button>
    </form>
{% else %}
    <form method="post" action="account/enable-2fa">
        <input type="hidden" name="action" value="enable">
        <button type="submit" class="btn btn-block btn-big-primary">Enable Two-Factor Authentication</button>
    </form>
{% endif %}

                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    
  
 
 
 
 
